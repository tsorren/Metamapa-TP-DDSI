@startuml
!theme plain

entity Hecho{
--PK--
    identificador (bigint)
--FK--
    fuente_id (bigint)
    categoria_id (bigint)
    contenido_id (bigint)
    etiqueta_id (bigint)
    Contribuyente_id (bigint)
--
    titulo (nvarchar(255))
    descripcion (nvarchar(255))
    latitud (decimal(18,2))
    longitud (decimal(18,2)
    fechaDelHecho (dateTime2(6))
    fechaDeCarga (dateTime2(6))
    fechaUltimaModificacion (dateTime2(6))
    origen (nvarchar(15)
    visible (bool)
}

entity Categoria{
    --PK--
    id (bigint)
    --
    nombre (nvarchar(255))
}

entity Etiqueta{
    --PK--
    id (bigint)
    --
    nombre (nvarchar(255))
}

entity Multimedia{
    --PK--
    id (bigint)
    --
    tipo_contenido (nvarchar(7))
    url (nvarchar(255))
}

entity Fuentedinamica {
    --PK--
    identificador (bigint)
    --
    fechaDeCreacion (dateTime2(6))
}

Hecho |o--|| Categoria
Hecho }o--o{ Etiqueta
Hecho ||--o| Multimedia
Hecho }o--|| Fuentedinamica

entity Administrador{
    --PK--
    id (bigint)
}

entity Contribuyente{
    --PK--
    id (bigint)
    --
    nombre (nvarchar(255))
    apellido (nvarchar(255))
    edad int
}
Hecho }o--|| Contribuyente

entity Solicitud_de_Creacion{
    --PK--
    id (bigint)
    --FK--
    hecho_id (bigint)
    contribuyente_id (bigint)
    --
    fechaCreacion (dateTime2(6))
}
Solicitud_de_Creacion }o--|| Hecho
Solicitud_de_Creacion ||--|| Contribuyente

entity Solicitud_de_Modificacion{
    --PK--
    id (bigint)
    --FK--
    hecho_id (bigint)
    contribuyente_id (bigint)
    --
    fechaCreacion (dateTime2(6))
}
Solicitud_de_Modificacion }o--|| Hecho
Solicitud_de_Modificacion }|--|| Contribuyente

entity Estado_Revision{
    --PK--
    id (bigint)
    --FK--
    administrador_id (bigint)
    solicitud_creacion_id (bigint)
    solicitud_modificacion_id (bigint)

    --
    fechaModificacion (dateTime2(6))
    estado (nvarchar(30))
    feedback (nvarchar(255))
}
Estado_Revision }|--|| Administrador
Estado_Revision }|--|| Solicitud_de_Creacion
Estado_Revision }|--|| Solicitud_de_Modificacion


@enduml